<% if (flash) { %>
<div class="flash flash-<%= flash.type %>">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
  <%= flash.msg %>
</div>
<% } %>

<%
function formatBytes(bytes) {
  if (!bytes) return '0 B';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024*1024) return (bytes/1024).toFixed(1)+' KB';
  return (bytes/(1024*1024)).toFixed(1)+' MB';
}
%>

<div style="display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:start">

  <div>
    <div class="card">
      <div class="card-header">
        <h2>Media Library <span class="badge badge-gray" style="margin-left:8px"><%= mediaFiles.length %></span></h2>
      </div>
      <div class="card-body">
        <% if (mediaFiles.length === 0) { %>
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <p>No media uploaded yet. Upload your first image →</p>
        </div>
        <% } else { %>
        <div class="media-grid">
          <% mediaFiles.forEach(function(f) { %>
          <div class="media-item">
            <img src="/uploads/<%= f.filename %>" alt="<%= f.alt_text||f.original_name %>" class="media-thumb">
            <div class="media-info">
              <strong title="<%= f.original_name %>"><%= f.original_name %></strong>
              <p><%= formatBytes(f.file_size) %> &bull; <%= (f.uploaded_at||'').split('T')[0]||'' %></p>
              <div class="media-url"
                onclick="navigator.clipboard.writeText('/uploads/<%= f.filename %>');this.textContent='Copied!';setTimeout(()=>this.textContent='/uploads/<%= f.filename %>',1500)"
                style="cursor:pointer;font-size:10.5px;color:#2d6a4f;margin-top:4px;word-break:break-all"
                title="Click to copy path">/uploads/<%= f.filename %></div>
              <span class="confirm-delete">
                <form method="POST" action="/admin/media/<%= f.id %>/delete" style="margin-top:8px">
                  <button type="submit" class="btn btn-danger btn-sm" style="width:100%;justify-content:center">Delete</button>
                </form>
              </span>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="card" style="position:sticky;top:76px">
    <div class="card-header"><h2>Upload Image</h2></div>
    <div class="card-body">
      <form method="POST" action="/admin/upload" enctype="multipart/form-data" id="upload-form">
        <div class="upload-zone" id="drop-zone" onclick="document.getElementById('file-input').click()">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <p>Click to upload or drag &amp; drop</p>
          <p style="font-size:11px;margin-top:4px">PNG, JPG, WebP up to 10MB</p>
        </div>
        <input type="file" id="file-input" name="image" accept="image/*" style="display:none" required>
        <div id="preview-wrap" style="display:none;margin-top:12px">
          <img id="preview-img" style="width:100%;border-radius:8px;max-height:160px;object-fit:cover" alt="Preview">
          <p id="preview-name" style="font-size:11px;color:#6b7280;margin-top:6px;text-align:center"></p>
        </div>
        <div class="form-group" style="margin-top:14px">
          <label>Alt Text</label>
          <input type="text" name="alt_text" placeholder="Describe the image for accessibility &amp; SEO">
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:12px">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0018 9h-1.26A8 8 0 103 16.3"/></svg>
          Upload Image
        </button>
      </form>
    </div>
  </div>

</div>

<script>
const fileInput   = document.getElementById('file-input');
const dropZone    = document.getElementById('drop-zone');
const previewImg  = document.getElementById('preview-img');
const previewName = document.getElementById('preview-name');
const previewWrap = document.getElementById('preview-wrap');

fileInput.addEventListener('change', function() { if (this.files[0]) showPreview(this.files[0]); });

['dragover','dragleave','drop'].forEach(function(evt) {
  dropZone.addEventListener(evt, function(e) {
    e.preventDefault();
    if (evt === 'dragover') dropZone.style.borderColor = '#2d6a4f';
    if (evt === 'dragleave') dropZone.style.borderColor = '#d1d5db';
    if (evt === 'drop') {
      dropZone.style.borderColor = '#d1d5db';
      var file = e.dataTransfer.files[0];
      if (file) {
        var dt = new DataTransfer();
        dt.items.add(file);
        fileInput.files = dt.files;
        showPreview(file);
      }
    }
  });
});

function showPreview(file) {
  var reader = new FileReader();
  reader.onload = function(e) {
    previewImg.src = e.target.result;
    previewName.textContent = file.name + ' (' + (file.size/1024).toFixed(1) + ' KB)';
    previewWrap.style.display = 'block';
  };
  reader.readAsDataURL(file);
}
</script>
