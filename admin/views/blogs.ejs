<% if (flash) { %>
<div class="flash flash-<%= flash.type %>">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
  <%= flash.msg %>
</div>
<% } %>

<form method="GET" action="/admin/blogs" class="search-bar">
  <input type="text" name="q" value="<%= q %>" placeholder="Search blogs..." style="flex:1;min-width:200px">
  <select name="cat">
    <option value="">All Categories</option>
    <% categories.forEach(function(c) { %><option value="<%= c %>" <%= c === cat ? 'selected' : '' %>><%= c %></option><% }) %>
  </select>
  <button type="submit" class="btn btn-secondary">Search</button>
  <% if (q || cat) { %><a href="/admin/blogs" class="btn btn-secondary">Clear</a><% } %>
</form>

<div class="card">
  <div class="card-header">
    <h2>Blog Posts <span class="badge badge-gray" style="margin-left:8px"><%= blogs.length %></span></h2>
  </div>
  <div class="card-body" style="padding:0">
    <% if (blogs.length === 0) { %>
    <div class="empty-state">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <p>No blog posts found. <a href="/admin/blogs/new" style="color:#2d6a4f;font-weight:600">Create your first post →</a></p>
    </div>
    <% } else { %>
    <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Title</th><th>Slug</th><th>Category</th><th>SEO</th><th>Date</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% blogs.forEach(function(b) { %>
        <tr>
          <td>
            <div class="td-truncate" style="max-width:220px;font-weight:600"><%= b.title %></div>
            <% if (b.image) { %><div style="color:#9ca3af;font-size:11px;margin-top:2px">Has image</div><% } %>
          </td>
          <td><code style="font-size:11px;background:#f3f4f6;padding:2px 6px;border-radius:4px"><%= b.slug %></code></td>
          <td><span class="badge badge-blue"><%= b.category %></span></td>
          <td>
            <% if (b.meta_title) { %><span class="badge badge-green" style="margin-right:3px">Title ✓</span><% } else { %><span class="badge badge-red">No title</span><% } %>
            <% if (b.meta_desc)  { %><span class="badge badge-green">Desc ✓</span><% } else { %><span class="badge badge-red">No desc</span><% } %>
          </td>
          <td style="color:#9ca3af;font-size:11px;white-space:nowrap"><%= (b.created_at||'').split('T')[0]||(b.created_at||'').split(' ')[0] %></td>
          <td>
            <div class="action-row">
              <a href="/admin/blogs/<%= b.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
              <a href="/blog/<%= b.slug %>.html" target="_blank" class="btn btn-secondary btn-sm btn-icon" title="View">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
              <span class="confirm-delete">
                <form method="POST" action="/admin/blogs/<%= b.id %>/delete" style="display:inline">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </span>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>
