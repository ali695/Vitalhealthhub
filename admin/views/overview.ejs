<% if (flash) { %>
<div class="flash flash-<%= flash.type %>">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
  <%= flash.msg %>
</div>
<% } %>

<div class="stats-row" style="grid-template-columns:repeat(7,1fr)">
  <div class="stat-card">
    <div class="stat-number"><%= totalPages %></div>
    <div class="stat-label">Pages</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= totalBlogs %></div>
    <div class="stat-label">Blog Posts</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= totalCalcs %></div>
    <div class="stat-label">Calculators</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= totalTools %></div>
    <div class="stat-label">Tools</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= totalQuizzes %></div>
    <div class="stat-label">Quizzes</div>
  </div>
  <div class="stat-card <%= missingMeta > 0 ? 'warn' : '' %>">
    <div class="stat-number"><%= missingMeta %></div>
    <div class="stat-label">Missing Meta</div>
  </div>
  <div class="stat-card <%= missingAlt > 0 ? 'warn' : '' %>">
    <div class="stat-number"><%= missingAlt %></div>
    <div class="stat-label">Missing Alt</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">

  <div class="card">
    <div class="card-header">
      <h2>Recent Blog Posts</h2>
      <a href="/admin/blogs/new" class="btn btn-primary btn-sm">+ New Post</a>
    </div>
    <div class="card-body" style="padding:0">
      <% if (recentBlogs.length === 0) { %>
      <div class="empty-state"><p>No blog posts yet. <a href="/admin/blogs/new" style="color:#2d6a4f;font-weight:600">Create one →</a></p></div>
      <% } else { %>
      <table>
        <thead><tr><th>Title</th><th>Category</th><th>Date</th><th></th></tr></thead>
        <tbody>
          <% recentBlogs.forEach(function(b) { %>
          <tr>
            <td class="td-truncate" style="max-width:180px"><%= b.title %></td>
            <td><span class="badge badge-blue"><%= b.category %></span></td>
            <td style="color:#9ca3af;font-size:11px"><%= (b.created_at||'').split('T')[0]||(b.created_at||'').split(' ')[0] %></td>
            <td><a href="/admin/blogs/<%= b.id %>/edit" class="btn btn-secondary btn-sm">Edit</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Recent Calculators</h2>
      <a href="/admin/calculators/new" class="btn btn-primary btn-sm">+ New</a>
    </div>
    <div class="card-body" style="padding:0">
      <% if (recentCalcs.length === 0) { %>
      <div class="empty-state"><p>No calculators yet.</p></div>
      <% } else { %>
      <table>
        <thead><tr><th>Title</th><th>Category</th><th></th></tr></thead>
        <tbody>
          <% recentCalcs.forEach(function(c) { %>
          <tr>
            <td class="td-truncate" style="max-width:200px"><%= c.title %></td>
            <td><span class="badge badge-green"><%= c.category %></span></td>
            <td><a href="/admin/calculators/<%= c.id %>/edit" class="btn btn-secondary btn-sm">Edit</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Recent Tools</h2>
      <a href="/admin/tools/new" class="btn btn-primary btn-sm">+ New</a>
    </div>
    <div class="card-body" style="padding:0">
      <% if (recentTools.length === 0) { %>
      <div class="empty-state"><p>No tools yet. <a href="/admin/tools/new" style="color:#2d6a4f;font-weight:600">Add one →</a></p></div>
      <% } else { %>
      <table>
        <thead><tr><th>Title</th><th>Category</th><th></th></tr></thead>
        <tbody>
          <% recentTools.forEach(function(t) { %>
          <tr>
            <td class="td-truncate" style="max-width:200px"><%= t.title %></td>
            <td><span class="badge badge-blue"><%= t.category %></span></td>
            <td><a href="/admin/tools/<%= t.id %>/edit" class="btn btn-secondary btn-sm">Edit</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Recent Quizzes</h2>
      <a href="/admin/quizzes/new" class="btn btn-primary btn-sm">+ New</a>
    </div>
    <div class="card-body" style="padding:0">
      <% if (recentQuizzes.length === 0) { %>
      <div class="empty-state"><p>No quizzes yet. <a href="/admin/quizzes/new" style="color:#2d6a4f;font-weight:600">Create one →</a></p></div>
      <% } else { %>
      <table>
        <thead><tr><th>Title</th><th>Questions</th><th></th></tr></thead>
        <tbody>
          <% recentQuizzes.forEach(function(q) { %>
          <%
            var qCount = 0;
            try { qCount = JSON.parse(q.questions||'[]').length; } catch(e) {}
          %>
          <tr>
            <td class="td-truncate" style="max-width:200px"><%= q.title %></td>
            <td><span class="badge badge-<%= qCount>0?'green':'yellow' %>"><%= qCount %> Q's</span></td>
            <td><a href="/admin/quizzes/<%= q.id %>/edit" class="btn btn-secondary btn-sm">Edit</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

</div>

<div class="card" style="margin-top:20px">
  <div class="card-header"><h2>Quick Actions</h2></div>
  <div class="card-body" style="display:flex;gap:12px;flex-wrap:wrap">
    <a href="/admin/blogs/new" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Blog Post
    </a>
    <a href="/admin/calculators/new" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Calculator
    </a>
    <a href="/admin/tools/new" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Tool
    </a>
    <a href="/admin/quizzes/new" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Quiz
    </a>
    <a href="/admin/seo-audit" class="btn btn-secondary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      SEO Audit
    </a>
    <a href="/admin/media" class="btn btn-secondary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      Media Library
    </a>
    <a href="/" target="_blank" class="btn btn-secondary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      View Live Site
    </a>
  </div>
</div>
