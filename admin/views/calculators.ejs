<% if (flash) { %>
<div class="flash flash-<%= flash.type %>">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
  <%= flash.msg %>
</div>
<% } %>

<div class="card">
  <div class="card-header">
    <h2>Calculators <span class="badge badge-gray" style="margin-left:8px"><%= calculators.length %></span></h2>
  </div>
  <div class="card-body" style="padding:0">
    <% if (calculators.length === 0) { %>
    <div class="empty-state">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="12" y2="14"/></svg>
      <p>No calculators yet. <a href="/admin/calculators/new" style="color:#2d6a4f;font-weight:600">Add one →</a></p>
    </div>
    <% } else { %>
    <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Title</th><th>Slug</th><th>Category</th><th>SEO</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% calculators.forEach(function(c) { %>
        <tr>
          <td>
            <div class="td-truncate" style="max-width:220px;font-weight:600"><%= c.title %></div>
            <% if (c.description) { %><div style="color:#9ca3af;font-size:11px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:220px"><%= c.description.substring(0,60) %><%= c.description.length>60?'...':'' %></div><% } %>
          </td>
          <td><code style="font-size:11px;background:#f3f4f6;padding:2px 6px;border-radius:4px"><%= c.slug %></code></td>
          <td><span class="badge badge-green"><%= c.category %></span></td>
          <td>
            <% if (c.meta_title) { %><span class="badge badge-green" style="margin-right:3px">Title ✓</span><% } else { %><span class="badge badge-red">No title</span><% } %>
            <% if (c.meta_desc)  { %><span class="badge badge-green">Desc ✓</span><% } else { %><span class="badge badge-red">No desc</span><% } %>
          </td>
          <td>
            <div class="action-row">
              <a href="/admin/calculators/<%= c.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
              <a href="/calculators/<%= c.slug %>.html" target="_blank" class="btn btn-secondary btn-sm btn-icon" title="View">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
              <span class="confirm-delete">
                <form method="POST" action="/admin/calculators/<%= c.id %>/delete" style="display:inline">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </span>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>
