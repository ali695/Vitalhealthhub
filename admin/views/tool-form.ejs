<% var isEdit = !!tool; %>
<% if (flash) { %>
<div class="flash flash-<%= flash.type %>"><%= flash.msg %></div>
<% } %>

<form method="POST" action="/admin/tools/<%= isEdit ? tool.id + '/edit' : 'new' %>">
  <div style="display:grid;grid-template-columns:1fr 300px;gap:20px;align-items:start">

    <div style="display:flex;flex-direction:column;gap:20px">

      <div class="card">
        <div class="card-header"><h2>Tool Info</h2></div>
        <div class="card-body">
          <div class="form-grid">
            <div class="form-group full">
              <label>Tool Title *</label>
              <input type="text" name="title" value="<%= isEdit ? tool.title : '' %>" placeholder="e.g. Habit Tracker" required id="titleInput">
            </div>
            <div class="form-group full">
              <label>URL Slug</label>
              <input type="text" name="slug" value="<%= isEdit ? tool.slug : '' %>" placeholder="auto-generated" id="slugInput">
              <div class="form-hint">URL: /tools/<strong id="slugPreview"><%= isEdit ? tool.slug : 'slug' %></strong>.html</div>
            </div>
            <div class="form-group full">
              <label>Description</label>
              <textarea name="description" rows="5" placeholder="Describe this tool, who it's for, and what problem it solves..."><%= isEdit ? tool.description : '' %></textarea>
            </div>
            <div class="form-group">
              <label>Category</label>
              <input type="text" name="category" value="<%= isEdit ? tool.category : 'General' %>" placeholder="e.g. Fitness, Nutrition, Sleep...">
            </div>
            <div class="form-group">
              <label>Tool Type</label>
              <select name="tool_type">
                <option value="web" <%= (!isEdit||tool.tool_type==='web')?'selected':'' %>>Web App</option>
                <option value="calculator" <%= (isEdit&&tool.tool_type==='calculator')?'selected':'' %>>Calculator</option>
                <option value="tracker" <%= (isEdit&&tool.tool_type==='tracker')?'selected':'' %>>Tracker</option>
                <option value="generator" <%= (isEdit&&tool.tool_type==='generator')?'selected':'' %>>Generator</option>
                <option value="external" <%= (isEdit&&tool.tool_type==='external')?'selected':'' %>>External Link</option>
              </select>
            </div>
            <div class="form-group full">
              <label>Tool Link / URL</label>
              <input type="text" name="link" value="<%= isEdit ? tool.link : '' %>" placeholder="https://... or /tools/my-tool">
              <div class="form-hint">Where the actual tool lives. Can be an internal path or external URL.</div>
            </div>
            <div class="form-group full">
              <label>Featured Image URL</label>
              <input type="text" name="image" value="<%= isEdit ? tool.image : '' %>" placeholder="/uploads/tool-image.jpg or full URL">
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><h2>SEO Settings</h2></div>
        <div class="card-body">
          <div class="form-grid">
            <div class="form-group full">
              <label>Meta Title <span style="font-weight:400;text-transform:none;color:#9ca3af">(50–60 chars ideal)</span></label>
              <input type="text" name="meta_title" id="metaTitle" value="<%= isEdit ? tool.meta_title : '' %>" placeholder="Tool title for search engines...">
              <div data-char-target="metaTitle" data-max="60" class="char-count"></div>
            </div>
            <div class="form-group full">
              <label>Meta Description <span style="font-weight:400;text-transform:none;color:#9ca3af">(140–160 chars)</span></label>
              <textarea name="meta_desc" id="metaDesc" rows="3" placeholder="Compelling description for search results..."><%= isEdit ? tool.meta_desc : '' %></textarea>
              <div data-char-target="metaDesc" data-max="160" class="char-count"></div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <div style="display:flex;flex-direction:column;gap:20px">
      <div class="card">
        <div class="card-header"><h2>Publish</h2></div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:12px">
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <%= isEdit ? 'Save & Regenerate' : 'Create & Generate HTML' %>
          </button>
          <a href="/admin/tools" class="btn btn-secondary" style="width:100%;justify-content:center">Cancel</a>
          <% if (isEdit) { %>
          <div style="padding-top:12px;border-top:1px solid #f3f4f6">
            <p style="font-size:11px;color:#9ca3af;margin-bottom:8px">Published at:</p>
            <code style="font-size:11px;background:#f3f4f6;padding:4px 8px;border-radius:6px;display:block;word-break:break-all">/tools/<%= tool.slug %>.html</code>
          </div>
          <div class="confirm-delete" style="margin-top:8px">
            <form method="POST" action="/admin/tools/<%= tool.id %>/delete">
              <button type="submit" class="btn btn-danger" style="width:100%;justify-content:center">Delete Tool</button>
            </form>
          </div>
          <% } %>
        </div>
      </div>

      <% if (mediaFiles && mediaFiles.length > 0) { %>
      <div class="card">
        <div class="card-header"><h2>Media Library</h2></div>
        <div class="card-body">
          <p style="font-size:11px;color:#6b7280;margin-bottom:8px">Click an image to use as featured image:</p>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;max-height:200px;overflow-y:auto">
            <% mediaFiles.slice(0,12).forEach(function(f) { %>
            <img src="/uploads/<%= f.filename %>" alt="<%= f.alt_text||f.original_name %>"
              title="Click to use"
              style="width:100%;height:52px;object-fit:cover;border-radius:6px;cursor:pointer;border:2px solid transparent;transition:border-color .2s"
              onmouseover="this.style.borderColor='#2d6a4f'"
              onmouseout="this.style.borderColor='transparent'"
              onclick="document.querySelector('[name=image]').value='/uploads/<%= f.filename %>'">
            <% }) %>
          </div>
        </div>
      </div>
      <% } %>
    </div>

  </div>
</form>

<script>
const titleInput  = document.getElementById('titleInput');
const slugInput   = document.getElementById('slugInput');
const slugPreview = document.getElementById('slugPreview');
function makeSlug(s) { return s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,''); }
<% if (!isEdit) { %>
titleInput.addEventListener('input', function() {
  const s = makeSlug(this.value);
  slugInput.value = s;
  slugPreview.textContent = s || 'slug';
});
<% } %>
slugInput.addEventListener('input', function() { slugPreview.textContent = makeSlug(this.value) || 'slug'; });
</script>
