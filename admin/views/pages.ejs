<% if (flash) { %>
<div class="flash flash-<%= flash.type %>">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
  <%= flash.msg %>
</div>
<% } %>

<form method="GET" action="/admin/pages" class="search-bar">
  <input type="text" name="q" value="<%= q %>" placeholder="Search pages..." style="flex:1;min-width:200px">
  <select name="status">
    <option value="">All Status</option>
    <option value="published" <%= statusFilter==='published'?'selected':'' %>>Published</option>
    <option value="draft"     <%= statusFilter==='draft'?'selected':'' %>>Draft</option>
  </select>
  <button type="submit" class="btn btn-secondary">Search</button>
  <% if (q || statusFilter) { %><a href="/admin/pages" class="btn btn-secondary">Clear</a><% } %>
</form>

<div class="card">
  <div class="card-header">
    <h2>Pages <span class="badge badge-gray" style="margin-left:8px"><%= pages.length %></span></h2>
  </div>
  <div class="card-body" style="padding:0">
    <% if (pages.length === 0) { %>
    <div class="empty-state">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <p>No pages yet. <a href="/admin/pages/new" style="color:#2d6a4f;font-weight:600">Create your first page →</a></p>
    </div>
    <% } else { %>
    <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Title</th><th>Slug / URL</th><th>Type</th><th>Status</th><th>SEO</th><th>Menu</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% pages.forEach(function(p) { %>
        <%
          const pageUrl = p.slug === 'home' ? '/' : '/' + p.slug + '.html';
          const isProtected = ['home','about','contact','faq','privacy','terms'].includes(p.slug);
        %>
        <tr>
          <td>
            <div class="td-truncate" style="max-width:180px;font-weight:600"><%= p.title %></div>
            <% if (isProtected) { %><span class="badge badge-gray" style="margin-top:3px;font-size:10px">Core Page</span><% } %>
          </td>
          <td>
            <code style="font-size:11px;background:#f3f4f6;padding:2px 6px;border-radius:4px"><%= pageUrl %></code>
          </td>
          <td>
            <span class="badge badge-blue"><%= p.page_type %></span>
          </td>
          <td>
            <form method="POST" action="/admin/pages/<%= p.id %>/toggle-status" style="display:inline">
              <button type="submit" class="badge <%= p.status==='published'?'badge-green':'badge-yellow' %>" style="border:none;cursor:pointer;font-size:11px">
                <%= p.status === 'published' ? '● Published' : '○ Draft' %>
              </button>
            </form>
          </td>
          <td>
            <% if (p.meta_title) { %><span class="badge badge-green" style="margin-right:3px">T ✓</span><% } else { %><span class="badge badge-red">No T</span><% } %>
            <% if (p.meta_desc)  { %><span class="badge badge-green">D ✓</span><% } else { %><span class="badge badge-red">No D</span><% } %>
          </td>
          <td>
            <div style="display:flex;gap:4px;flex-wrap:wrap">
              <% if (p.in_nav)    { %><span class="badge badge-blue"  style="font-size:10px">Nav</span><% } %>
              <% if (p.in_footer) { %><span class="badge badge-gray"  style="font-size:10px">Footer</span><% } %>
              <% if (!p.in_nav && !p.in_footer) { %><span style="color:#d1d5db;font-size:12px">—</span><% } %>
            </div>
          </td>
          <td>
            <div class="action-row">
              <a href="/admin/pages/<%= p.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
              <a href="<%= pageUrl %>" target="_blank" class="btn btn-secondary btn-sm btn-icon" title="View">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
              <% if (!isProtected) { %>
              <span class="confirm-delete">
                <form method="POST" action="/admin/pages/<%= p.id %>/delete" style="display:inline">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </span>
              <% } %>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>

<div class="card" style="margin-top:20px">
  <div class="card-header"><h2>Page Types & Schemas</h2></div>
  <div class="card-body">
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">
      <% [
        ['general','WebPage','Default for custom pages'],
        ['home','WebSite','Homepage with search action'],
        ['about','AboutPage','Organization info schema'],
        ['contact','ContactPage','Contact form schema'],
        ['faq','FAQPage','FAQ structured data'],
        ['landing','WebPage','Marketing landing pages']
      ].forEach(function(t) { %>
      <div style="background:#f9fafb;border-radius:10px;padding:14px;border:1px solid #e5e7eb">
        <div style="font-weight:700;font-size:13px;color:#1b1f1e;margin-bottom:4px"><%= t[0] %></div>
        <div style="font-size:11px;color:#2d6a4f;margin-bottom:6px">Schema: <%= t[1] %></div>
        <div style="font-size:11px;color:#9ca3af"><%= t[2] %></div>
      </div>
      <% }) %>
    </div>
  </div>
</div>
