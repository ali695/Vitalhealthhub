<%
var missingTitle = issues.filter(function(i) { return !i.title; });
var missingDesc  = issues.filter(function(i) { return !i.desc; });
var missingH1    = issues.filter(function(i) { return !i.h1; });
var missingAlt   = issues.filter(function(i) { return i.imgNoAlt > 0; });
%>

<div class="stats-row" style="grid-template-columns:repeat(4,1fr)">
  <div class="stat-card <%= missingTitle.length > 0 ? 'danger' : '' %>">
    <div class="stat-number"><%= missingTitle.length %></div>
    <div class="stat-label">Missing Title Tags</div>
  </div>
  <div class="stat-card <%= missingDesc.length > 0 ? 'warn' : '' %>">
    <div class="stat-number"><%= missingDesc.length %></div>
    <div class="stat-label">Missing Meta Desc</div>
  </div>
  <div class="stat-card <%= missingH1.length > 0 ? 'warn' : '' %>">
    <div class="stat-number"><%= missingH1.length %></div>
    <div class="stat-label">Missing H1 Tags</div>
  </div>
  <div class="stat-card <%= missingAlt.length > 0 ? 'warn' : '' %>">
    <div class="stat-number"><%= missingAlt.length %></div>
    <div class="stat-label">Images Without Alt</div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2>Pages with SEO Issues <span class="badge badge-gray" style="margin-left:8px"><%= issues.length %></span></h2>
    <a href="/admin/seo-audit" class="btn btn-secondary btn-sm">Refresh</a>
  </div>
  <div class="card-body" style="padding:0">
    <% if (issues.length === 0) { %>
    <div class="empty-state">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <p style="color:#059669;font-weight:600">All pages look good! No SEO issues found.</p>
    </div>
    <% } else { %>
    <div class="table-wrap">
    <table>
      <thead>
        <tr><th>File</th><th>Title</th><th>Description</th><th>H1</th><th>Imgs No Alt</th></tr>
      </thead>
      <tbody>
        <% issues.forEach(function(i) { %>
        <tr>
          <td><code style="font-size:11px;background:#f3f4f6;padding:2px 6px;border-radius:4px;display:inline-block;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= i.file %></code></td>
          <td>
            <% if (i.title) { %><span class="badge badge-green" title="<%= i.title %>">✓</span><% } else { %><span class="badge badge-red">Missing</span><% } %>
          </td>
          <td>
            <% if (i.desc) { %><span class="badge badge-green">✓</span><% } else { %><span class="badge badge-red">Missing</span><% } %>
          </td>
          <td>
            <% if (i.h1) { %><span class="badge badge-green" title="<%= i.h1 %>">✓</span><% } else { %><span class="badge badge-red">Missing</span><% } %>
          </td>
          <td>
            <% if (i.imgNoAlt > 0) { %><span class="badge badge-yellow"><%= i.imgNoAlt %> image<%= i.imgNoAlt>1?'s':'' %></span><% } else { %><span class="badge badge-green">✓</span><% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>

<div class="card" style="margin-top:20px">
  <div class="card-header"><h2>SEO Checklist</h2></div>
  <div class="card-body">
    <ul style="list-style:none;display:flex;flex-direction:column;gap:12px">
      <li style="display:flex;gap:10px;align-items:flex-start">
        <span style="background:#d1fae5;color:#059669;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:700">1</span>
        <span style="font-size:13px;color:#374151"><strong>Title tags</strong> — 50–60 characters. Include your primary keyword near the beginning.</span>
      </li>
      <li style="display:flex;gap:10px;align-items:flex-start">
        <span style="background:#d1fae5;color:#059669;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:700">2</span>
        <span style="font-size:13px;color:#374151"><strong>Meta descriptions</strong> — 140–160 characters. Write a compelling summary that encourages clicks.</span>
      </li>
      <li style="display:flex;gap:10px;align-items:flex-start">
        <span style="background:#d1fae5;color:#059669;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:700">3</span>
        <span style="font-size:13px;color:#374151"><strong>H1 tags</strong> — each page should have exactly one H1 that clearly states the page topic.</span>
      </li>
      <li style="display:flex;gap:10px;align-items:flex-start">
        <span style="background:#d1fae5;color:#059669;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:700">4</span>
        <span style="font-size:13px;color:#374151"><strong>Alt text</strong> on every image — helps accessibility and image SEO.</span>
      </li>
    </ul>
  </div>
</div>
