# VitalHealth Hub security headers
#
# UPDATED FOR ADSENSE + GOOGLE CMP (Funding Choices).
#
# What changed from the previous version and why:
#
# script-src   Added Google's ad and consent hosts. Still no 'unsafe-inline' —
#              that stays gone. This is where the real XSS protection lives, so
#              it is kept as tight as AdSense allows.
#
# img-src      Widened to https:. AdSense creatives are served from whatever
#              domain the advertiser uses, and that list is not publishable.
#              A strict allowlist here will silently break creatives. Images
#              cannot execute code, so this is a much smaller risk than script.
#
# frame-src    Widened to https: for the same reason: ad iframes come from
#              arbitrary advertiser domains.
#
# connect-src  Added Google's ad measurement and consent endpoints.
#
# frame-ancestors / X-Frame-Options
#              Temporarily permits Google's AdSense editor to frame the site
#              so the "Excluded areas" preview can load and be saved.
#
# If an ad or the consent banner still does not appear, open the live site,
# check the browser console for "Refused to load ... violates the following
# Content Security Policy directive", and add the host it names. Google does
# not publish a complete, stable list, so console-driven is more reliable
# than guessing.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com https://adservice.google.com https://fundingchoicesmessages.google.com https://ep2.adtrafficquality.google https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.web3forms.com https://api.frankfurter.app https://api.coingecko.com https://metals.live https://image.pollinations.ai https://cloudflareinsights.com https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://ep1.adtrafficquality.google https://csi.gstatic.com https://fundingchoicesmessages.google.com https://www.google-analytics.com https://analytics.google.com; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'self' https://google.com https://*.google.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/images/*
  Cache-Control: public, max-age=2592000

/404.html
  X-Robots-Tag: noindex, follow

https://vitalhealthhub.pages.dev/*
  X-Robots-Tag: noindex

https://:branch.vitalhealthhub.pages.dev/*
  X-Robots-Tag: noindex

# ---------------------------------------------------------------------------
# TEMPORARY ADSENSE "EXCLUDED AREAS" ACCESS IS ACTIVE
#
# The policy above permits this site and Google origins to embed the site.
# X-Frame-Options is intentionally omitted because DENY blocks the editor.
#
# Active framing exception:
#
#     frame-ancestors 'self' https://*.google.com
#     (and DELETE the X-Frame-Options line entirely — that header cannot list
#      a second origin, and leaving DENY there overrides frame-ancestors in
#      some browsers)
#
# After marking and saving the excluded areas in AdSense, restore both protections.
# Leaving the site framable long-term reopens clickjacking risk for no benefit,
# because the exclusions are stored on Google's side once saved.
# ---------------------------------------------------------------------------
