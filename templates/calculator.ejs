<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= metaTitle || title %></title>
<meta name="description" content="<%= metaDesc || description %>">
<% const canon = canonical || ('/calculators/' + slug + '.html'); %>
<link rel="canonical" href="https://vitalhealthhub.org<%= canon.replace(/\.html$/, '') %>">
<meta property="og:title" content="<%= metaTitle || title %>">
<meta property="og:description" content="<%= metaDesc || description %>">
<meta property="og:type" content="website">
<meta property="og:url" content="https://vitalhealthhub.org<%= canon.replace(/\.html$/, '') %>">
<link rel="stylesheet" href="/css/style.css">
<% if (schemaJson) { %>
<script type="application/ld+json"><%- schemaJson %></script>
<% } %>
</head>
<body>
<%- nav %>
<div class="breadcrumbs"><div class="breadcrumbs-inner">
<a href="/">Home</a><span>/</span><a href="/calculators/">Calculators</a><span>/</span><span><%= title %></span>
</div></div>
<section class="content-page" style="padding-top:130px;padding-bottom:60px;">
<div class="container" style="max-width:760px;">
<div class="section-title" style="margin-bottom:32px;">
<span class="blog-card-category"><%= category %></span>
<h1 style="margin-top:12px;"><%= title %></h1>
<p style="color:var(--gray-500);margin-top:12px;"><%= description %></p>
</div>
<div class="calc-form fade-in" style="text-align:center;padding:40px;background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);">
<p style="color:var(--gray-700);margin-bottom:24px;">This calculator page is managed via the VitalHealth Hub CMS.</p>
<a href="/calculators/" class="btn btn-primary">Browse All Calculators →</a>
</div>
<% if (description) { %>
<div style="margin-top:48px;">
<h2 style="margin-bottom:16px;">About This Calculator</h2>
<p style="color:var(--gray-700);line-height:1.8;"><%- description %></p>
</div>
<% } %>
</div>
</section>
<%- footer %>
<%- btt %>
<script src="/js/main.js"></script>
<%- chatbot %>
</body>
</html>
