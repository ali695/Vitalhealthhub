<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= meta_title || title %></title>
<meta name="description" content="<%= meta_desc || description %>">
<link rel="canonical" href="https://vitalhealthhub.org/quizzes/<%= slug %>">
<meta property="og:title" content="<%= meta_title || title %>">
<meta property="og:description" content="<%= meta_desc || description %>">
<meta property="og:type" content="website">
<meta property="og:url" content="https://vitalhealthhub.org/quizzes/<%= slug %>">
<link rel="stylesheet" href="/css/style.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Quiz",
  "name": "<%= title %>",
  "description": "<%= meta_desc || description %>",
  "url": "https://vitalhealthhub.org/quizzes/<%= slug %>",
  "publisher": {"@type": "Organization", "name": "VitalHealth Hub", "url": "https://vitalhealthhub.org"}
}
</script>
<style>
.quiz-wrap{max-width:760px;margin:0 auto;padding:40px 20px 80px}
.quiz-intro{background:var(--white);border-radius:20px;padding:40px;box-shadow:var(--shadow);text-align:center;margin-bottom:32px}
.quiz-intro h1{font-size:2rem;margin-bottom:12px;color:var(--green-dark)}
.quiz-intro p{color:var(--gray-500);font-size:1.05rem;line-height:1.7;margin-bottom:24px}
.quiz-progress-bar{height:6px;background:#e5e7eb;border-radius:6px;margin-bottom:32px;overflow:hidden}
.quiz-progress-fill{height:100%;background:linear-gradient(90deg,#2d6a4f,#52b788);border-radius:6px;transition:width .4s ease}
.quiz-progress-label{display:flex;justify-content:space-between;font-size:12px;color:var(--gray-400);margin-bottom:8px}
.quiz-q-card{background:var(--white);border-radius:20px;padding:36px;box-shadow:var(--shadow);display:none;animation:fadeIn .3s ease}
.quiz-q-card.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.quiz-q-num{font-size:12px;font-weight:700;color:#52b788;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px}
.quiz-q-text{font-size:1.2rem;font-weight:700;color:var(--green-dark);margin-bottom:24px;line-height:1.5}
.quiz-options{display:flex;flex-direction:column;gap:12px}
.quiz-option{display:flex;align-items:center;gap:14px;padding:14px 18px;border:2px solid #e5e7eb;border-radius:12px;cursor:pointer;transition:all .2s;font-size:0.95rem;color:var(--gray-700);background:#fff}
.quiz-option:hover{border-color:#52b788;background:#f0fdf4;color:var(--green-dark)}
.quiz-option.selected{border-color:#2d6a4f;background:#f0fdf4;color:var(--green-dark);font-weight:600}
.quiz-option.correct{border-color:#059669;background:#d1fae5;color:#065f46}
.quiz-option.wrong{border-color:#ef4444;background:#fee2e2;color:#991b1b}
.quiz-option-letter{width:32px;height:32px;border-radius:50%;background:#f3f4f6;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;flex-shrink:0;transition:all .2s}
.quiz-option.selected .quiz-option-letter{background:#2d6a4f;color:#fff}
.quiz-option.correct .quiz-option-letter{background:#059669;color:#fff}
.quiz-option.wrong .quiz-option-letter{background:#ef4444;color:#fff}
.quiz-explanation{margin-top:18px;padding:14px 18px;background:#f0fdf4;border-left:4px solid #52b788;border-radius:0 10px 10px 0;font-size:0.9rem;color:#374151;line-height:1.6;display:none}
.quiz-nav{display:flex;justify-content:space-between;align-items:center;margin-top:28px;gap:12px}
.quiz-result-card{background:var(--white);border-radius:20px;padding:48px;box-shadow:var(--shadow);text-align:center;display:none}
.quiz-result-card.active{display:block}
.result-score-circle{width:120px;height:120px;border-radius:50%;margin:0 auto 24px;display:flex;align-items:center;justify-content:center;flex-direction:column;font-weight:900;font-size:2rem;line-height:1}
.result-score-circle small{font-size:12px;font-weight:600;margin-top:4px}
.result-title{font-size:1.8rem;font-weight:800;margin-bottom:12px;color:var(--green-dark)}
.result-desc{color:var(--gray-600);font-size:1rem;line-height:1.8;max-width:520px;margin:0 auto 32px}
.result-breakdown{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:32px}
.result-stat{background:#f9fafb;border-radius:12px;padding:16px 24px;text-align:center}
.result-stat strong{display:block;font-size:1.5rem;font-weight:800;color:var(--green-dark)}
.result-stat span{font-size:12px;color:var(--gray-400)}
</style>
</head>
<body>
<%- nav %>
<div class="breadcrumbs"><div class="breadcrumbs-inner">
  <a href="/">Home</a><span>/</span><a href="/quizzes/">Quizzes</a><span>/</span><span><%= title %></span>
</div></div>

<section style="padding-top:120px">
<div class="quiz-wrap">

  <div class="quiz-intro" id="quiz-intro">
    <span class="blog-card-category" style="margin-bottom:16px;display:inline-block"><%= category %></span>
    <h1><%= title %></h1>
    <% if (description) { %><p><%= description %></p><% } %>
    <div style="display:flex;gap:24px;justify-content:center;margin-bottom:28px">
      <div style="text-align:center"><strong style="font-size:1.4rem;color:var(--green-dark)" id="q-count">0</strong><div style="font-size:12px;color:var(--gray-400);margin-top:2px">Questions</div></div>
      <div style="text-align:center"><strong style="font-size:1.4rem;color:var(--green-dark)">Free</strong><div style="font-size:12px;color:var(--gray-400);margin-top:2px">No Sign-up</div></div>
      <div style="text-align:center"><strong style="font-size:1.4rem;color:var(--green-dark)">Instant</strong><div style="font-size:12px;color:var(--gray-400);margin-top:2px">Results</div></div>
    </div>
    <button class="btn btn-primary" style="font-size:1rem;padding:14px 40px" onclick="startQuiz()">Start Quiz →</button>
  </div>

  <div id="quiz-area" style="display:none">
    <div class="quiz-progress-label">
      <span id="q-label">Question 1</span>
      <span id="q-fraction">1 of 0</span>
    </div>
    <div class="quiz-progress-bar"><div class="quiz-progress-fill" id="progress-fill" style="width:0%"></div></div>
    <div id="questions-container"></div>
  </div>

  <div class="quiz-result-card" id="quiz-result">
    <div class="result-score-circle" id="result-circle">
      <span id="result-pct">0%</span>
      <small>Score</small>
    </div>
    <h2 class="result-title" id="result-title">Well done!</h2>
    <p class="result-desc" id="result-desc"></p>
    <div class="result-breakdown">
      <div class="result-stat"><strong id="res-correct">0</strong><span>Correct</span></div>
      <div class="result-stat"><strong id="res-wrong">0</strong><span>Wrong</span></div>
      <div class="result-stat"><strong id="res-total">0</strong><span>Total</span></div>
    </div>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
      <button class="btn btn-primary" style="padding:12px 28px" onclick="retakeQuiz()">Retake Quiz</button>
      <a href="/quizzes/" class="btn btn-secondary" style="padding:12px 28px">More Quizzes</a>
      <a href="/blog.html" class="btn btn-secondary" style="padding:12px 28px">Health Articles</a>
    </div>
  </div>

</div>
</section>

<%- footer %>
<%- btt %>
<script src="/js/main.js"></script>
<%- chatbot %>
<script>
const QUIZ_DATA = <%- questionsJson %>;
const RESULTS   = <%- resultsJson %>;
const letters = ['A','B','C','D','E','F'];

let current = 0;
let answers  = [];
let started  = false;

document.getElementById('q-count').textContent = QUIZ_DATA.length;

function startQuiz() {
  document.getElementById('quiz-intro').style.display = 'none';
  document.getElementById('quiz-area').style.display  = 'block';
  renderQuestions();
  showQuestion(0);
}

function renderQuestions() {
  const container = document.getElementById('questions-container');
  container.innerHTML = '';
  QUIZ_DATA.forEach(function(q, qi) {
    const card = document.createElement('div');
    card.className = 'quiz-q-card' + (qi === 0 ? ' active' : '');
    card.id = 'q-card-' + qi;
    let optsHtml = '';
    (q.options || []).forEach(function(opt, oi) {
      optsHtml += `<div class="quiz-option" id="opt-${qi}-${oi}" onclick="selectOption(${qi},${oi})">
        <span class="quiz-option-letter">${letters[oi]}</span>
        <span>${opt}</span>
      </div>`;
    });
    const hasExpl = q.explanation && q.explanation.trim();
    card.innerHTML = `
      <div class="quiz-q-num">Question ${qi+1} of ${QUIZ_DATA.length}</div>
      <div class="quiz-q-text">${q.q}</div>
      <div class="quiz-options" id="opts-${qi}">${optsHtml}</div>
      ${hasExpl ? `<div class="quiz-explanation" id="expl-${qi}"><strong>Explanation:</strong> ${q.explanation}</div>` : ''}
      <div class="quiz-nav">
        ${qi > 0 ? `<button class="btn btn-secondary" onclick="prevQ()">← Back</button>` : '<span></span>'}
        <button class="btn btn-primary" id="next-btn-${qi}" onclick="nextQ(${qi})" disabled style="margin-left:auto">
          ${qi === QUIZ_DATA.length-1 ? 'See Results →' : 'Next →'}
        </button>
      </div>`;
    container.appendChild(card);
  });
}

function showQuestion(idx) {
  document.querySelectorAll('.quiz-q-card').forEach(function(c) { c.classList.remove('active'); });
  const card = document.getElementById('q-card-' + idx);
  if (card) card.classList.add('active');
  current = idx;
  const pct = QUIZ_DATA.length ? ((idx / QUIZ_DATA.length) * 100) : 0;
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('q-label').textContent = 'Question ' + (idx+1);
  document.getElementById('q-fraction').textContent = (idx+1) + ' of ' + QUIZ_DATA.length;
  if (answers[idx] !== undefined) {
    document.getElementById('next-btn-' + idx).disabled = false;
  }
}

function selectOption(qi, oi) {
  if (answers[qi] !== undefined) return;
  answers[qi] = oi;
  const q = QUIZ_DATA[qi];
  const correct = q.correct !== undefined ? parseInt(q.correct) : -1;
  (q.options || []).forEach(function(_, i) {
    const el = document.getElementById('opt-' + qi + '-' + i);
    if (i === oi) el.classList.add(i === correct ? 'correct' : 'wrong');
    else if (i === correct) el.classList.add('correct');
    el.style.pointerEvents = 'none';
  });
  const expl = document.getElementById('expl-' + qi);
  if (expl) expl.style.display = 'block';
  document.getElementById('next-btn-' + qi).disabled = false;
}

function nextQ(qi) {
  if (qi >= QUIZ_DATA.length - 1) { showResults(); return; }
  showQuestion(qi + 1);
}

function prevQ() {
  if (current > 0) showQuestion(current - 1);
}

function showResults() {
  document.getElementById('quiz-area').style.display = 'none';
  const resultCard = document.getElementById('quiz-result');
  resultCard.classList.add('active');
  let correct = 0;
  QUIZ_DATA.forEach(function(q, qi) {
    if (answers[qi] !== undefined && parseInt(q.correct) === answers[qi]) correct++;
  });
  const total = QUIZ_DATA.length;
  const pct   = total ? Math.round((correct / total) * 100) : 0;
  document.getElementById('result-pct').textContent  = pct + '%';
  document.getElementById('res-correct').textContent = correct;
  document.getElementById('res-wrong').textContent   = total - correct;
  document.getElementById('res-total').textContent   = total;
  let tier = RESULTS.low || {};
  if (pct > 70) tier = RESULTS.high || {};
  else if (pct > 40) tier = RESULTS.mid || {};
  document.getElementById('result-title').textContent = tier.title || (pct >= 70 ? 'Excellent!' : pct >= 40 ? 'Good Effort!' : 'Keep Learning!');
  document.getElementById('result-desc').textContent  = tier.desc  || 'Thanks for taking the quiz!';
  const circle = document.getElementById('result-circle');
  circle.style.background = pct >= 70 ? 'linear-gradient(135deg,#d1fae5,#a7f3d0)' : pct >= 40 ? 'linear-gradient(135deg,#fef3c7,#fde68a)' : 'linear-gradient(135deg,#fee2e2,#fecaca)';
  circle.style.color = pct >= 70 ? '#065f46' : pct >= 40 ? '#92400e' : '#991b1b';
}

function retakeQuiz() {
  answers = [];
  current = 0;
  document.getElementById('quiz-result').classList.remove('active');
  document.getElementById('quiz-area').style.display  = 'block';
  renderQuestions();
  showQuestion(0);
}
</script>
</body>
</html>
