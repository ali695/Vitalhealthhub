<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= meta_title || title %></title>
<meta name="description" content="<%= meta_desc || description %>">
<link rel="canonical" href="https://vitalhealthhub.com/tools/<%= slug %>.html">
<meta property="og:title" content="<%= meta_title || title %>">
<meta property="og:description" content="<%= meta_desc || description %>">
<meta property="og:type" content="website">
<meta property="og:url" content="https://vitalhealthhub.com/tools/<%= slug %>.html">
<% if (image) { %><meta property="og:image" content="<%= image %>"><% } %>
<link rel="stylesheet" href="/css/style.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "<%= title %>",
  "description": "<%= meta_desc || description %>",
  "url": "https://vitalhealthhub.com/tools/<%= slug %>.html",
  "applicationCategory": "HealthApplication",
  "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"},
  "publisher": {"@type": "Organization", "name": "VitalHealth Hub", "url": "https://vitalhealthhub.com"}
}
</script>
</head>
<body>
<%- nav %>
<div class="breadcrumbs"><div class="breadcrumbs-inner">
  <a href="/">Home</a><span>/</span><a href="/tools/">Tools</a><span>/</span><span><%= title %></span>
</div></div>

<section class="content-page" style="padding-top:130px;padding-bottom:80px;">
  <div class="container" style="max-width:800px;">

    <% if (image) { %>
    <div style="margin-bottom:32px;">
      <img src="<%= image %>" alt="<%= title %>" style="width:100%;max-height:360px;object-fit:cover;border-radius:16px;box-shadow:0 4px 24px rgba(0,0,0,.12)">
    </div>
    <% } %>

    <div class="section-title" style="margin-bottom:32px;">
      <span class="blog-card-category"><%= category %></span>
      <h1 style="margin-top:12px;font-size:2.2rem;"><%= title %></h1>
      <% if (description) { %>
      <p style="color:var(--gray-500);margin-top:16px;font-size:1.05rem;line-height:1.8;"><%- description %></p>
      <% } %>
    </div>

    <% if (link) { %>
    <div style="margin-bottom:48px;">
      <a href="<%= link %>" class="btn btn-primary" style="font-size:1rem;padding:14px 32px;" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:8px"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Open Tool
      </a>
      <a href="/tools/" class="btn btn-secondary" style="font-size:1rem;padding:14px 32px;margin-left:12px;">Browse All Tools</a>
    </div>
    <% } %>

    <div style="background:var(--white);border-radius:16px;padding:32px;box-shadow:var(--shadow);border:1px solid var(--gray-100);">
      <h2 style="font-size:1.2rem;margin-bottom:16px;color:var(--green-dark);">About This Tool</h2>
      <div style="color:var(--gray-700);line-height:1.9;font-size:1rem;">
        <% if (description) { %><%- description %><% } else { %><p>This free health tool is provided by VitalHealth Hub to help you make informed decisions about your health and wellness.</p><% } %>
      </div>
    </div>

    <div style="margin-top:32px;display:flex;gap:12px;flex-wrap:wrap">
      <a href="/" style="color:var(--green-mid);font-size:0.9rem;">Home</a>
      <span style="color:var(--gray-300)">→</span>
      <a href="/tools/" style="color:var(--green-mid);font-size:0.9rem;">All Tools</a>
      <span style="color:var(--gray-300)">→</span>
      <a href="/calculators/" style="color:var(--green-mid);font-size:0.9rem;">Calculators</a>
      <span style="color:var(--gray-300)">→</span>
      <a href="/blog.html" style="color:var(--green-mid);font-size:0.9rem;">Health Blog</a>
    </div>

  </div>
</section>

<%- footer %>
<%- btt %>
<script src="/js/main.js"></script>
<%- chatbot %>
</body>
</html>
